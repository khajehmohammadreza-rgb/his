Options -Indexes
DirectoryIndex router.php

<IfModule mod_setenvif.c>
  SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # NetAfraz/LiteSpeed may drop Authorization after an internal rewrite.
  # Preserve the Bearer token so authenticated POST requests (e.g. center save)
  # reach router.php with the same credentials as the browser request.
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^data(?:/|$) - [F,L,NC]
  RewriteRule ^router\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^(.*)$ router.php?route=$1 [QSA,L]
</IfModule>

<FilesMatch "^(config(?:\.local)?|db|updater|vendor_prepare_lib|restore_backup_cli|recovery_lib|patch[0-9]+_verify)\.php$">
  Require all denied
</FilesMatch>
